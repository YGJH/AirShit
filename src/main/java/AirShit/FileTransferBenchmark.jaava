package AirShit;

import java.io.File;
import java.io.IOException;
import java.net.ServerSocket;
import java.util.concurrent.atomic.AtomicLong;

/**
 * 檔案傳輸效能基準測試
 * 比較不同實作的效能差異
 */
public class FileTransferBenchmark {
    
    private static final String TEST_FILE_PATH = "benchmark_test_file.bin";
    private static final long TEST_FILE_SIZE_MB = 100; // 100MB 測試檔案
    private static final int[] THREAD_COUNTS = {1, 2, 4, 8, 16, 32};
    private static final int PORT = 12345;
    
    public static void main(String[] args) {
        System.out.println("=== 檔案傳輸效能基準測試 ===");
        System.out.println("CPU 核心數: " + Runtime.getRuntime().availableProcessors());
        System.out.println("測試檔案大小: " + TEST_FILE_SIZE_MB + " MB");
        System.out.println();
        
        // 建立測試檔案
        createTestFile();
        
        // 測試不同執行緒數的效能
        for (int threadCount : THREAD_COUNTS) {
            System.out.println("--- 測試執行緒數: " + threadCount + " ---");
            
            // 測試優化版本
            TestResult optimizedResult = testOptimizedVersion(threadCount);
            
            // 測試原始版本 (如果可用)
            TestResult originalResult = testOriginalVersion(threadCount);
            
            // 比較結果
            compareResults(threadCount, optimizedResult, originalResult);
            
            System.out.println();
            
            // 短暫休息
            try {
                Thread.sleep(2000);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
                break;
            }
        }
        
        // 清理測試檔案
        cleanupTestFile();
        
        System.out.println("基準測試完成");
    }
    
    private static void createTestFile() {
        System.out.println("建立測試檔案...");
        
        try (java.io.RandomAccessFile raf = new java.io.RandomAccessFile(TEST_FILE_PATH, "rw")) {
            raf.setLength(TEST_FILE_SIZE_MB * 1024 * 1024);
            
            // 填入隨機測試資料
            byte[] buffer = new byte[1024 * 1024]; // 1MB buffer
            for (int i = 0; i < buffer.length; i++) {
                buffer[i] = (byte) (Math.random() * 256);
            }
            
            for (long i = 0; i < TEST_FILE_SIZE_MB; i++) {
                raf.write(buffer);
            }
            
        } catch (IOException e) {
            System.err.println("建立測試檔案失敗: " + e.getMessage());
            System.exit(1);
        }
    }
    
    private static TestResult testOptimizedVersion(int threadCount) {
        System.out.println("測試優化版本 (SendFileOptimized + ReceiverOptimized)");
        
        File testFile = new File(TEST_FILE_PATH);
        String outputFile = "received_optimized_" + threadCount + ".bin";
        
        AtomicLong totalBytesSent = new AtomicLong(0);
        AtomicLong totalBytesReceived = new AtomicLong(0);
        long[] startTime = {0};
        long[] endTime = {0};
        boolean[] success = {false};
        
        // 接收端回調
        TransferCallback receiverCallback = new TransferCallback() {
            @Override
            public void onStart(long totalSize) {
                startTime[0] = System.currentTimeMillis();
            }
            
            @Override
            public void onProgress(long bytes) {
                totalBytesReceived.addAndGet(bytes);
            }
            
            @Override
            public void onComplete() {
                endTime[0] = System.currentTimeMillis();
                success[0] = true;
            }
            
            @Override
            public void onComplete(String name) {
                onComplete();
            }
            
            @Override
            public void onError(Exception e) {
                System.err.println("接收錯誤: " + e.getMessage());
            }
        };
        
        // 發送端回調
        TransferCallback senderCallback = new TransferCallback() {
            @Override
            public void onStart(long totalSize) {
                // 由接收端記錄開始時間
            }
            
            @Override
            public void onProgress(long bytes) {
                totalBytesSent.addAndGet(bytes);
            }
            
            @Override
            public void onComplete() {
                // 傳送完成
            }
            
            @Override
            public void onComplete(String name) {
                onComplete();
            }
            
            @Override
            public void onError(Exception e) {
                System.err.println("發送錯誤: " + e.getMessage());
            }
        };
        
        // 啟動接收端
        Thread receiverThread = new Thread(() -> {
            try (ServerSocket serverSocket = new ServerSocket(PORT)) {
                ReceiverOptimized receiver = new ReceiverOptimized(serverSocket);
                receiver.start(outputFile, testFile.length(), threadCount, receiverCallback);
            } catch (Exception e) {
                System.err.println("接收端錯誤: " + e.getMessage());
            }
        });
        receiverThread.start();
        
        // 等待伺服器啟動
        try {
            Thread.sleep(1000);
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }
        
        // 啟動發送端
        try {
            SendFileOptimized sender = new SendFileOptimized("localhost", PORT, testFile, threadCount, senderCallback);
            sender.start();
        } catch (Exception e) {
            System.err.println("發送端錯誤: " + e.getMessage());
        }
        
        // 等待完成
        try {
            receiverThread.join(60000); // 最多等待 60 秒
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }
        
        // 計算結果
        long duration = endTime[0] - startTime[0];
        double throughputMBps = (double) testFile.length() / duration * 1000 / 1024 / 1024;
        
        // 清理輸出檔案
        new File(outputFile).delete();
        
        return new TestResult(
            "Optimized",
            threadCount,
            duration,
            throughputMBps,
            totalBytesSent.get(),
            totalBytesReceived.get(),
            success[0]
        );
    }
    
    private static TestResult testOriginalVersion(int threadCount) {
        System.out.println("測試原始版本 (SendFile + Receiver)");
        
        File testFile = new File(TEST_FILE_PATH);
        String outputFile = "received_original_" + threadCount + ".bin";
        
        AtomicLong totalBytesSent = new AtomicLong(0);
        AtomicLong totalBytesReceived = new AtomicLong(0);
        long[] startTime = {0};
        long[] endTime = {0};
        boolean[] success = {false};
        
        // 接收端回調
        TransferCallback receiverCallback = new TransferCallback() {
            @Override
            public void onStart(long totalSize) {
                startTime[0] = System.currentTimeMillis();
            }
            
            @Override
            public void onProgress(long bytes) {
                totalBytesReceived.addAndGet(bytes);
            }
            
            @Override
            public void onComplete() {
                endTime[0] = System.currentTimeMillis();
                success[0] = true;
            }
            
            @Override
            public void onComplete(String name) {
                onComplete();
            }
            
            @Override
            public void onError(Exception e) {
                System.err.println("接收錯誤: " + e.getMessage());
            }
        };
        
        // 發送端回調
        TransferCallback senderCallback = new TransferCallback() {
            @Override
            public void onStart(long totalSize) {
                // 由接收端記錄開始時間
            }
            
            @Override
            public void onProgress(long bytes) {
                totalBytesSent.addAndGet(bytes);
            }
            
            @Override
            public void onComplete() {
                // 傳送完成
            }
            
            @Override
            public void onComplete(String name) {
                onComplete();
            }
            
            @Override
            public void onError(Exception e) {
                System.err.println("發送錯誤: " + e.getMessage());
            }
        };
        
        // 啟動接收端
        Thread receiverThread = new Thread(() -> {
            try (ServerSocket serverSocket = new ServerSocket(PORT + 1)) {
                Receiver receiver = new Receiver(serverSocket);
                receiver.start(outputFile, testFile.length(), threadCount, receiverCallback);
            } catch (Exception e) {
                System.err.println("接收端錯誤: " + e.getMessage());
            }
        });
        receiverThread.start();
        
        // 等待伺服器啟動
        try {
            Thread.sleep(1000);
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }
        
        // 啟動發送端
        try {
            SendFile sender = new SendFile("localhost", PORT + 1, testFile, threadCount, senderCallback);
            sender.start();
        } catch (Exception e) {
            System.err.println("發送端錯誤: " + e.getMessage());
        }
        
        // 等待完成
        try {
            receiverThread.join(60000); // 最多等待 60 秒
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }
        
        // 計算結果
        long duration = endTime[0] - startTime[0];
        double throughputMBps = (duration > 0) ? (double) testFile.length() / duration * 1000 / 1024 / 1024 : 0;
        
        // 清理輸出檔案
        new File(outputFile).delete();
        
        return new TestResult(
            "Original",
            threadCount,
            duration,
            throughputMBps,
            totalBytesSent.get(),
            totalBytesReceived.get(),
            success[0]
        );
    }
    
    private static void compareResults(int threadCount, TestResult optimized, TestResult original) {
        System.out.printf("執行緒數: %d%n", threadCount);
        System.out.printf("優化版本: %.2f MB/s (%d ms)%n", optimized.throughputMBps, optimized.durationMs);
        System.out.printf("原始版本: %.2f MB/s (%d ms)%n", original.throughputMBps, original.durationMs);
        
        if (original.throughputMBps > 0) {
            double improvement = (optimized.throughputMBps - original.throughputMBps) / original.throughputMBps * 100;
            System.out.printf("效能提升: %.1f%%%n", improvement);
        }
        
        System.out.printf("優化版本成功: %s, 原始版本成功: %s%n", optimized.success, original.success);
    }
    
    private static void cleanupTestFile() {
        new File(TEST_FILE_PATH).delete();
    }
      private static class TestResult {
        @SuppressWarnings("unused")
        final String version;
        @SuppressWarnings("unused")
        final int threadCount;
        final long durationMs;
        final double throughputMBps;
        @SuppressWarnings("unused")
        final long bytesSent;
        @SuppressWarnings("unused")
        final long bytesReceived;
        final boolean success;
        
        TestResult(String version, int threadCount, long durationMs, double throughputMBps,
                  long bytesSent, long bytesReceived, boolean success) {
            this.version = version;
            this.threadCount = threadCount;
            this.durationMs = durationMs;
            this.throughputMBps = throughputMBps;
            this.bytesSent = bytesSent;
            this.bytesReceived = bytesReceived;
            this.success = success;
        }
    }
}
